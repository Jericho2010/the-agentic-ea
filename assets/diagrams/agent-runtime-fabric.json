    {
      "dot": "emerald",
      "title": "Layer 3: Evo 2 Agent Runtime Fabric (Omnigent + Herdr)",
      "items": [
        "Omnigent Control Plane: Enforces spending caps, token quotas, OS sandboxing (Bubblewrap), and live session URLs",
        "Herdr Terminal Multiplexer: Manages PTY sessions, detects agent state (working/blocked/done), and allocates Git worktrees",
        "Supervised Agent Fleet: ARB Reviewer, Archify Visualizer, Strategic Copilot, and Cartographer running inside sandboxed panes"
      ]
    },
    {
      "dot": "amber",
      "title": "Layer 4: Databricks Enterprise Data Backbone (Part 9)",
      "items": [
        "Unity Catalog: Canonical PAM knowledge graph (nodes, edges, evidence Delta tables) with atomic merge ingestion",
        "Lakebase Managed PostgreSQL: Powers the operational Backstage catalog and user state",
        "Gold Scenario Marts: Pre-aggregates TIME disposition, tech debt, and cloud FinOps telemetry"
