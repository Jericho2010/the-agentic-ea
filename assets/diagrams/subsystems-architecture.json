      "title": "Layer 1: Human Personas & Surfaces",
      "items": [
        "Enterprise Architect: Uses Backstage daily cockpit, approves PR waivers, directs Copilot",
        "Software Engineer: Works where code lives (GitHub PRs) and views Backstage catalog",
        "CIO & Leadership: Monitors Databricks AI/BI dashboards and asks plain-language questions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layer 2: Autonomous Agent Workforce",
      "items": [
        "ARB Reviewer Agent: Evaluates PR diffs against standards and triggers Archify diffs",
        "Strategic Copilot Agent: Simulates blast radius and cuts target-state ADR drafts",
        "Tri-Modal LLM Engine: Pluggable execution (Mosaic AI, External API, or Demo Subscription CLI)"
      ]
    },
    {
      "dot": "amber",
      "title": "Layer 3: Enterprise Data Backbone",
      "items": [
        "Unity Catalog: Stores the live PAM knowledge graph (nodes, edges, evidence)",
        "Lakebase Managed Postgres: Houses Backstage operational catalog and ARB action queues",
        "Gold Scenario Marts: Pre-aggregates TIME disposition, EOL risk, and cloud FinOps telemetry"
      ]
    }
  ]
