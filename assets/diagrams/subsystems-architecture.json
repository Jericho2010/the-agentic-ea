    {
      "dot": "cyan",
      "title": "Layer 1: Human Personas & The 3 Workspaces",
      "items": [
        "Software Engineer: Works strictly in GitHub PRs with automated visual diffs and zero context switching",
        "Enterprise Architect: Single unified cockpit in Backstage (Databricks Apps) with living maps and Copilot drawer",
        "CIO & Tech Leadership: Consumes executive portfolio health and FinOps metrics in Databricks AI/BI"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layer 2: Autonomous Agent Workforce & AI Engines",
      "items": [
        "ARB Reviewer Agent: Automated compliance checking against PAM rules on every GitHub pull request",
        "Archify Visualizer: Compiles deterministic SVG diffs for PRs and interactive living maps for Backstage",
        "Strategic Copilot: Natural-language reasoning engine for What-If scenario simulations and ADR drafts",
        "Cartographer Agent: Background scanner auto-discovering ASTs, cloud resources, and pipelines",
        "Tri-Modal LLM Engine: Pluggable execution (Mosaic AI Serving, External API, or Local Subscription CLI)"
      ]
    },
    {
      "dot": "amber",
      "title": "Layer 3: Databricks Enterprise Data Backbone",
      "items": [
        "Unity Catalog: Stores the live PAM knowledge graph (nodes, edges, evidence Delta tables)",
        "Lakebase Managed PostgreSQL: Powers the Backstage software catalog and operational state",
        "Gold Scenario Marts: Pre-aggregates TIME disposition, tech debt, and cloud FinOps telemetry"
      ]
    }
  ]
